local function AddScriptButton(title, description, badgeText, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -6, 0, 56)
    Button.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = ScriptContainer

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Button

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Thickness = 1
    BtnStroke.Color = Color3.fromRGB(40, 40, 50)
    BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    BtnStroke.Parent = Button

    local BtnTitle = Instance.new("TextLabel")
    BtnTitle.Size = UDim2.new(1, -100, 0, 20)
    BtnTitle.Position = UDim2.new(0, 14, 0, 10)
    BtnTitle.Text = title
    BtnTitle.TextColor3 = Color3.fromRGB(240, 240, 245)
    BtnTitle.TextXAlignment = Enum.TextXAlignment.Left
    BtnTitle.Font = Enum.Font.GothamBold
    BtnTitle.TextSize = 14
    BtnTitle.BackgroundTransparency = 1
    BtnTitle.Parent = Button

    local BtnDesc = Instance.new("TextLabel")
    BtnDesc.Size = UDim2.new(1, -30, 0, 16)
    BtnDesc.Position = UDim2.new(0, 14, 0, 30)
    BtnDesc.Text = description
    BtnDesc.TextColor3 = Color3.fromRGB(130, 130, 145)
    BtnDesc.TextXAlignment = Enum.TextXAlignment.Left
    BtnDesc.Font = Enum.Font.Gotham
    BtnDesc.TextSize = 12
    BtnDesc.BackgroundTransparency = 1
    BtnDesc.Parent = Button

    if badgeText then
        local Badge = Instance.new("Frame")
        Badge.Size = UDim2.new(0, 70, 0, 20)
        Badge.Position = UDim2.new(1, -80, 0, 10)
        Badge.BackgroundColor3 = Color3.fromRGB(35, 45, 60)
        Badge.BorderSizePixel = 0
        Badge.Parent = Button

        local BadgeCorner = Instance.new("UICorner")
        BadgeCorner.CornerRadius = UDim.new(0, 4)
        BadgeCorner.Parent = Badge

        local BadgeLabel = Instance.new("TextLabel")
        BadgeLabel.Size = UDim2.new(1, 0, 1, 0)
        BadgeLabel.Text = badgeText
        BadgeLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
        BadgeLabel.Font = Enum.Font.GothamBold
        BadgeLabel.TextSize = 10
        BadgeLabel.BackgroundTransparency = 1
        BadgeLabel.Parent = Badge
    end

    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(34, 34, 46)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(80, 80, 110)}):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(26, 26, 34)}):Play()
        TweenService:Create(BtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(40, 40, 50)}):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        local Flash = TweenService:Create(Button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 70)})
        Flash:Play()
        Flash.Completed:Connect(function()
            TweenService:Create(Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(34, 34, 46)}):Play()
        end)
        pcall(callback)
    end)
end

local dragging, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

TopBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        TweenService:Create(MainFrame, TweenInfo.new(0.05), {
            Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        }):Play()
    end
end)

